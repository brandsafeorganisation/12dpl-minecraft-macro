#ifndef TEST_REPORT_PAGE_4DM_INCLUDED
#define TEST_REPORT_PAGE_4DM_INCLUDED

// ----------------------------------------------------------------
// The report page around the run's numbers. Written by
// tools/make_report_page.py from test/report/report_page.html:
// edit that file and run the script, not this one.
// ----------------------------------------------------------------

void test_report_page_start(File &p_file)
// ----------------------------------------------------------------
// Write the report page up to the run's numbers (styles and layout)
// ----------------------------------------------------------------
{
  File_write_line(p_file, "<!doctype html>");
  File_write_line(p_file, "<html lang='en'><head><meta charset='utf-8'>");
  File_write_line(p_file, "<meta name='viewport' content='width=device-width, initial-scale=1'>");
  File_write_line(p_file, "<title>Cubeland test report</title>");
  File_write_line(p_file, "<style>");
  File_write_line(p_file, ":root{--bg:#f4f5f8;--panel:#fff;--ink:#1b1e24;--soft:#5d6574;--line:#e2e5eb;--accent:#4f6bed;");
  File_write_line(p_file, "--good:#1f9d55;--bad:#d64545;--warn:#d9911a;--s1:#4f6bed;--s2:#e0782f;--s3:#2aa198;--bar:#4f6bed;");
  File_write_line(p_file, "--code:#1d2027;--codeink:#d6dbe5;--hover:#f0f2f7;--chip:#eef0f5}");
  File_write_line(p_file, "@media (prefers-color-scheme:dark){:root{--bg:#121418;--panel:#1b1e24;--ink:#e6e8ee;--soft:#9aa2b1;");
  File_write_line(p_file, "--line:#2c3039;--accent:#7b93ff;--hover:#232730;--chip:#262a33;--code:#0f1115}}");
  File_write_line(p_file, "*{box-sizing:border-box}");
  File_write_line(p_file, "body{margin:0;font:14px/1.45 'Segoe UI',system-ui,-apple-system,Arial,sans-serif;background:var(--bg);color:var(--ink)}");
  File_write_line(p_file, "header{padding:28px 32px 0}");
  File_write_line(p_file, "h1{margin:0;font-size:26px;letter-spacing:-.3px}");
  File_write_line(p_file, "h2{font-size:17px;margin:0 0 12px}");
  File_write_line(p_file, "h3{font-size:14px;margin:18px 0 8px;color:var(--soft);text-transform:uppercase;letter-spacing:.6px}");
  File_write_line(p_file, ".sub{color:var(--soft);margin-top:4px}");
  File_write_line(p_file, ".wrap{padding:0 32px 48px}");
  File_write_line(p_file, ".cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:20px 0}");
  File_write_line(p_file, ".card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px}");
  File_write_line(p_file, ".card .k{color:var(--soft);font-size:12px;text-transform:uppercase;letter-spacing:.5px}");
  File_write_line(p_file, ".card .v{font-size:24px;font-weight:650;margin-top:2px;font-variant-numeric:tabular-nums}");
  File_write_line(p_file, ".card .v.good{color:var(--good)}.card .v.bad{color:var(--bad)}");
  File_write_line(p_file, ".card .d{color:var(--soft);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}");
  File_write_line(p_file, ".note{background:#fff3d6;color:#5a4300;border:1px solid #ecc76a;border-radius:10px;padding:10px 14px;margin:16px 0}");
  File_write_line(p_file, "nav{display:flex;gap:4px;border-bottom:1px solid var(--line);margin:8px 0 20px;position:sticky;top:0;background:var(--bg);z-index:5;padding-top:8px}");
  File_write_line(p_file, "nav button{border:0;background:none;color:var(--soft);padding:10px 14px;font:inherit;cursor:pointer;border-bottom:2px solid transparent}");
  File_write_line(p_file, "nav button.on{color:var(--ink);border-bottom-color:var(--accent);font-weight:600}");
  File_write_line(p_file, "nav .count{background:var(--chip);border-radius:10px;padding:0 7px;margin-left:6px;font-size:12px}");
  File_write_line(p_file, ".grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(440px,1fr));gap:16px}");
  File_write_line(p_file, ".panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px;min-width:0}");
  File_write_line(p_file, ".panel p.hint{color:var(--soft);margin:-6px 0 10px;font-size:12px}");
  File_write_line(p_file, "svg text{fill:var(--ink);font-size:12px}");
  File_write_line(p_file, "svg .muted{fill:var(--soft)}");
  File_write_line(p_file, "svg .hit{cursor:pointer}");
  File_write_line(p_file, "svg .hit:hover rect.b{opacity:.75}");
  File_write_line(p_file, ".tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}");
  File_write_line(p_file, "input[type=search],select{font:inherit;padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--ink)}");
  File_write_line(p_file, "input[type=search]{min-width:240px}");
  File_write_line(p_file, "label.chk{color:var(--soft);display:flex;gap:6px;align-items:center}");
  File_write_line(p_file, "table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}");
  File_write_line(p_file, "th,td{padding:7px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}");
  File_write_line(p_file, "th{font-size:12px;color:var(--soft);text-transform:uppercase;letter-spacing:.4px;white-space:nowrap;position:sticky;top:44px;background:var(--panel);z-index:2}");
  File_write_line(p_file, "th.sort{cursor:pointer;user-select:none}");
  File_write_line(p_file, "th.sort:hover{color:var(--ink)}");
  File_write_line(p_file, "th.up::after{content:' \\25B2 ';font-size:9px}th.down::after{content:' \\25BC ';font-size:9px}");
  File_write_line(p_file, "td.n,th.n{text-align:right;white-space:nowrap}");
  File_write_line(p_file, "tbody tr:hover{background:var(--hover)}");
  File_write_line(p_file, "a.fn{color:var(--accent);text-decoration:none;cursor:pointer;font-weight:550}");
  File_write_line(p_file, "a.fn:hover{text-decoration:underline}");
  File_write_line(p_file, ".tag{display:inline-block;font-size:11px;padding:1px 7px;border-radius:9px;background:var(--chip);color:var(--soft);margin-left:4px}");
  File_write_line(p_file, ".tag.bad{background:#fde3e3;color:#a32121}.tag.good{background:#dcf3e5;color:#16673a}.tag.warn{background:#fdf0d5;color:#8a5a00}");
  File_write_line(p_file, ".pass{color:var(--good);font-weight:600}.fail{color:var(--bad);font-weight:600}");
  File_write_line(p_file, ".mini{display:inline-block;height:8px;border-radius:4px;background:var(--bar);vertical-align:middle;margin-left:6px;opacity:.8}");
  File_write_line(p_file, ".sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}");
  File_write_line(p_file, ".legend{color:var(--soft);font-size:12px;display:flex;gap:14px;margin-bottom:6px}");
  File_write_line(p_file, "#drawer{position:fixed;top:0;right:0;bottom:0;width:min(980px,96vw);background:var(--bg);border-left:1px solid var(--line);");
  File_write_line(p_file, "box-shadow:-12px 0 40px rgba(0,0,0,.18);transform:translateX(105%);transition:transform .2s;overflow:auto;z-index:20;padding:22px 26px 40px}");
  File_write_line(p_file, "#drawer.open{transform:none}");
  File_write_line(p_file, "#drawer .close{position:sticky;top:0;float:right;border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:8px;padding:6px 12px;cursor:pointer;font:inherit}");
  File_write_line(p_file, ".sig{font-family:Consolas,'Cascadia Mono',monospace;background:var(--chip);padding:8px 10px;border-radius:8px;overflow:auto;white-space:pre}");
  File_write_line(p_file, "dl{display:grid;grid-template-columns:150px 1fr;gap:6px 14px;margin:12px 0}");
  File_write_line(p_file, "dt{color:var(--soft)}dd{margin:0;min-width:0;overflow-wrap:anywhere}");
  File_write_line(p_file, "pre.code{background:var(--code);color:var(--codeink);padding:12px 14px;border-radius:10px;overflow:auto;font-size:12px;line-height:1.5}");
  File_write_line(p_file, "#drawer td:first-child{white-space:nowrap}");
  File_write_line(p_file, ".mono{font-family:Consolas,'Cascadia Mono',monospace;font-size:12px;overflow-wrap:anywhere}");
  File_write_line(p_file, ".tabs2 button{border:1px solid var(--line);background:var(--panel);color:var(--soft);border-radius:8px;padding:5px 10px;font:inherit;cursor:pointer;margin-right:6px}");
  File_write_line(p_file, ".tabs2 button.on{color:var(--ink);border-color:var(--accent)}");
  File_write_line(p_file, ".empty{color:var(--soft);padding:20px;text-align:center}");
  File_write_line(p_file, ".hidden{display:none}");
  File_write_line(p_file, "</style></head><body>");
  File_write_line(p_file, "<header><h1>Cubeland test report</h1><div class='sub' id='subtitle'></div></header>");
  File_write_line(p_file, "<div class='wrap'>");
  File_write_line(p_file, "<div id='note'></div>");
  File_write_line(p_file, "<div class='cards' id='cards'></div>");
  File_write_line(p_file, "<nav id='nav'></nav>");
  File_write_line(p_file, "<section id='tab-overview'></section>");
  File_write_line(p_file, "<section id='tab-functions' class='hidden'></section>");
  File_write_line(p_file, "<section id='tab-sets' class='hidden'></section>");
  File_write_line(p_file, "<section id='tab-tests' class='hidden'></section>");
  File_write_line(p_file, "<section id='tab-left' class='hidden'></section>");
  File_write_line(p_file, "</div>");
  File_write_line(p_file, "<div id='drawer'></div>");
}

void test_report_page_end(File &p_file)
// ----------------------------------------------------------------
// Write the rest of the report page (the script that draws it)
// ----------------------------------------------------------------
{
  File_write_line(p_file, "<script>");
  File_write_line(p_file, "'use strict';");
  File_write_line(p_file, "const SETS = ['', 'typical', 'random', 'edges'];");
  File_write_line(p_file, "const SET_COLOUR = ['', 'var(--s1)', 'var(--s2)', 'var(--s3)'];");
  File_write_line(p_file, "const BUCKETS = ['< 1 \\u00b5s', '1-3 \\u00b5s', '3-10 \\u00b5s', '10-30 \\u00b5s', '30-100 \\u00b5s', '0.1-0.3 ms', '0.3-1 ms', '> 1 ms'];");
  File_write_line(p_file, "const $ = (id) => document.getElementById(id);");
  File_write_line(p_file, "const esc = (t) => String(t).replace(/[&<>']/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', [String.fromCharCode(39)]: '&#39;'})[c]);");
  File_write_line(p_file, "function us(v) {");
  File_write_line(p_file, "  if (v === null || v === undefined || isNaN(v)) return '-';");
  File_write_line(p_file, "  if (v >= 100000) return (v / 1000000).toFixed(2) + ' s';");
  File_write_line(p_file, "  if (v >= 1000) return (v / 1000).toFixed(2) + ' ms';");
  File_write_line(p_file, "  if (v >= 10) return v.toFixed(1) + ' \\u00b5s';");
  File_write_line(p_file, "  return v.toFixed(3) + ' \\u00b5s';");
  File_write_line(p_file, "}");
  File_write_line(p_file, "function num(v) { return (v === null || v === undefined) ? '-' : Number(v).toLocaleString(undefined, {maximumFractionDigits: 4}); }");
  File_write_line(p_file, "function big(v) { return Number(v).toLocaleString(); }");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- the numbers per function");
  File_write_line(p_file, "const fnById = {};");
  File_write_line(p_file, "for (const f of R.fns) fnById[f.id] = f;");
  File_write_line(p_file, "const byFn = new Map();");
  File_write_line(p_file, "for (const r of R.runs) {");
  File_write_line(p_file, "  r.sd = Math.sqrt(Math.max(0, r.sq - r.mean * r.mean));");
  File_write_line(p_file, "  r.fn = fnById[r.f];");
  File_write_line(p_file, "  if (!byFn.has(r.f)) byFn.set(r.f, {f: r.f, fn: r.fn, sets: {}, calls: 0, sum: 0, max: 0, min: Infinity, total: 0});");
  File_write_line(p_file, "  const a = byFn.get(r.f);");
  File_write_line(p_file, "  a.sets[r.s] = r;");
  File_write_line(p_file, "  a.calls += r.n; a.sum += r.mean * r.n; a.total += r.fnms;");
  File_write_line(p_file, "  a.max = Math.max(a.max, r.max); a.min = Math.min(a.min, r.min);");
  File_write_line(p_file, "}");
  File_write_line(p_file, "const rows = [...byFn.values()];");
  File_write_line(p_file, "for (const a of rows) {");
  File_write_line(p_file, "  a.mean = a.calls ? a.sum / a.calls : 0;");
  File_write_line(p_file, "  const means = Object.values(a.sets).map((r) => r.mean).filter((m) => m > 0);");
  File_write_line(p_file, "  // (times under a microsecond are mostly the clock's own steps, so");
  File_write_line(p_file, "  // the ratio counts anything faster as one microsecond)");
  File_write_line(p_file, "  a.ratio = means.length > 1 ? Math.max(1, ...means) / Math.max(1, Math.min(...means)) : 1;");
  File_write_line(p_file, "  a.sd = Math.max(...Object.values(a.sets).map((r) => r.sd));");
  File_write_line(p_file, "  a.jitter = a.mean > 0 ? a.sd / a.mean : 0;");
  File_write_line(p_file, "  a.suspicious = Object.values(a.sets).some((r) => r.hasret && (r.rmin <= -2147483648 || r.rmax >= 2147483647 || !isFinite(r.rmin) || !isFinite(r.rmax) || !isFinite(r.rmean) || Math.abs(r.rmin) > 1e300 || Math.abs(r.rmax) > 1e300));");
  File_write_line(p_file, "  a.differs = (() => {");
  File_write_line(p_file, "    const s = Object.values(a.sets).filter((r) => r.hasret);");
  File_write_line(p_file, "    return s.length > 1 && s.some((r) => r.rmin !== s[0].rmin || r.rmax !== s[0].rmax);");
  File_write_line(p_file, "  })();");
  File_write_line(p_file, "}");
  File_write_line(p_file, "const parts = [...new Set(rows.map((a) => a.fn.part))].sort();");
  File_write_line(p_file, "const failed = R.checks.filter((c) => !c[4]);");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- header");
  File_write_line(p_file, "$('subtitle').textContent = R.title + ' \\u00b7 started ' + R.started + ' \\u00b7 ' + R.seconds.toFixed(3) + ' s';");
  File_write_line(p_file, "if (R.note) $('note').innerHTML = '<div class=note>The previous test run stopped inside <b>' + esc(R.note) +");
  File_write_line(p_file, "  '</b> (a macro error, or 12d was closed). It may not handle the inputs it was given there.</div>';");
  File_write_line(p_file, "const cards = [];");
  File_write_line(p_file, "const totalCalls = rows.reduce((s, a) => s + a.calls, 0);");
  File_write_line(p_file, "const slowest = rows.slice().sort((x, y) => y.mean - x.mean)[0];");
  File_write_line(p_file, "cards.push(['Functions run', big(rows.length), R.skipped.length ? R.skipped.length + ' left out' : 'none left out']);");
  File_write_line(p_file, "cards.push(['Calls made', big(totalCalls), Object.keys(R.runs.reduce((o, r) => (o[r.s] = 1, o), {})).map((s) => SETS[s]).join(', ') || ' ']);");
  File_write_line(p_file, "if (R.checks.length) {");
  File_write_line(p_file, "  cards.push(['Checks passed', (R.checks.length - failed.length) + ' / ' + R.checks.length, failed.length ? failed.length + ' failed' : 'all passed', failed.length ? 'bad' : 'good']);");
  File_write_line(p_file, "}");
  File_write_line(p_file, "if (slowest) cards.push(['Slowest on average', us(slowest.mean), slowest.fn.name]);");
  File_write_line(p_file, "cards.push(['Time in functions', us(rows.reduce((s, a) => s + a.total, 0) * 1000), 'whole run ' + R.seconds.toFixed(2) + ' s']);");
  File_write_line(p_file, "cards.push(['Suspicious results', big(rows.filter((a) => a.suspicious).length), 'returned NaN, infinity, or the largest or smallest number', rows.some((a) => a.suspicious) ? 'bad' : '']);");
  File_write_line(p_file, "$('cards').innerHTML = cards.map((c) => `<div class=card><div class=k>${esc(c[0])}</div><div class='v ${c[3] || ''}'>${esc(c[1])}</div><div class=d title='${esc(c[2])}'>${esc(c[2])}</div></div>`).join('');");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- tabs");
  File_write_line(p_file, "const TABS = [['overview', 'Overview', ''], ['functions', 'Functions', rows.length], ['sets', 'Data sets', ''],");
  File_write_line(p_file, "  ['tests', 'Unit tests', R.checks.length ? (failed.length ? failed.length + ' failed' : R.checks.length) : ''], ['left', 'Left out', R.skipped.length]];");
  File_write_line(p_file, "function showTab(id) {");
  File_write_line(p_file, "  for (const t of TABS) {");
  File_write_line(p_file, "    $('tab-' + t[0]).classList.toggle('hidden', t[0] !== id);");
  File_write_line(p_file, "    $('nb-' + t[0]).classList.toggle('on', t[0] === id);");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "}");
  File_write_line(p_file, "$('nav').innerHTML = TABS.map((t) => `<button id='nb-${t[0]}' data-tab='${t[0]}'>${t[1]}${t[2] !== '' ? `<span class=count>${t[2]}</span>` : ''}</button>`).join('');");
  File_write_line(p_file, "$('nav').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) showTab(b.dataset.tab); });");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- charts");
  File_write_line(p_file, "function barChart(items, fmt, opts) {");
  File_write_line(p_file, "  opts = opts || {};");
  File_write_line(p_file, "  if (!items.length) return '<div class=empty>Nothing to show</div>';");
  File_write_line(p_file, "  const w = 560, rowH = 22, left = 210, right = 90;");
  File_write_line(p_file, "  const max = Math.max(...items.map((i) => i.value)) || 1;");
  File_write_line(p_file, "  let s = `<svg viewBox='0 0 ${w} ${items.length * rowH + 4}' width='100%' role='img'>`;");
  File_write_line(p_file, "  items.forEach((it, k) => {");
  File_write_line(p_file, "    const y = k * rowH + 2, bw = Math.max(2, (w - left - right) * it.value / max);");
  File_write_line(p_file, "    const label = it.label.length > 30 ? it.label.slice(0, 29) + '\\u2026' : it.label;");
  File_write_line(p_file, "    s += `<g class='${it.id ? 'hit' : ''}' data-fn='${it.id || ''}'><title>${esc(it.label)}: ${esc(fmt(it.value))}${it.tip ? ' \\u00b7 ' + esc(it.tip) : ''}</title>`;");
  File_write_line(p_file, "    s += `<text x='${left - 8}' y='${y + 15}' text-anchor='end'>${esc(label)}</text>`;");
  File_write_line(p_file, "    s += `<rect class=b x='${left}' y='${y + 4}' width='${bw}' height='${rowH - 8}' rx='4' fill='${it.colour || 'var(--bar)'}'></rect>`;");
  File_write_line(p_file, "    s += `<text class=muted x='${left + bw + 6}' y='${y + 15}'>${esc(fmt(it.value))}</text></g>`;");
  File_write_line(p_file, "  });");
  File_write_line(p_file, "  return s + '</svg>';");
  File_write_line(p_file, "}");
  File_write_line(p_file, "function groupedBars(groups, series, fmt) {");
  File_write_line(p_file, "  // groups: [{label, values:[...]}], series: [{name, colour}]");
  File_write_line(p_file, "  const w = 560, h = 190, left = 66, bottom = 42, top = 10;");
  File_write_line(p_file, "  const max = Math.max(1e-9, ...groups.flatMap((g) => g.values.filter((v) => v !== null)));");
  File_write_line(p_file, "  const gw = (w - left - 10) / groups.length, bw = Math.max(3, (gw - 8) / series.length);");
  File_write_line(p_file, "  let s = `<svg viewBox='0 0 ${w} ${h}' width='100%'>`;");
  File_write_line(p_file, "  for (let k = 0; k <= 4; k++) {");
  File_write_line(p_file, "    const y = top + (h - top - bottom) * (1 - k / 4);");
  File_write_line(p_file, "    s += `<line x1='${left}' x2='${w}' y1='${y}' y2='${y}' stroke='var(--line)'></line><text class=muted x='${left - 6}' y='${y + 4}' text-anchor='end'>${esc(fmt(max * k / 4))}</text>`;");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "  groups.forEach((g, i) => {");
  File_write_line(p_file, "    const x0 = left + i * gw + 4;");
  File_write_line(p_file, "    g.values.forEach((v, j) => {");
  File_write_line(p_file, "      if (v === null) return;");
  File_write_line(p_file, "      const bh = (h - top - bottom) * v / max;");
  File_write_line(p_file, "      s += `<rect x='${x0 + j * bw}' y='${h - bottom - bh}' width='${bw - 2}' height='${Math.max(0, bh)}' rx='2' fill='${series[j].colour}'><title>${esc(g.label)} \\u00b7 ${esc(series[j].name)}: ${esc(fmt(v))}</title></rect>`;");
  File_write_line(p_file, "    });");
  File_write_line(p_file, "    s += `<text class=muted x='${x0 + gw / 2 - 4}' y='${h - bottom + 16}' text-anchor='middle'>${esc(g.label)}</text>`;");
  File_write_line(p_file, "  });");
  File_write_line(p_file, "  return s + '</svg>';");
  File_write_line(p_file, "}");
  File_write_line(p_file, "function legend(series) { return '<div class=legend>' + series.map((s) => `<span><span class=sw style='background:${s.colour}'></span>${esc(s.name)}</span>`).join('') + '</div>'; }");
  File_write_line(p_file, "function topN(list, key, n) { return list.slice().sort((x, y) => key(y) - key(x)).slice(0, n || 15); }");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- overview");
  File_write_line(p_file, "(function overview() {");
  File_write_line(p_file, "  const P = [];");
  File_write_line(p_file, "  const panel = (title, hint, body) => P.push(`<div class=panel><h2>${title}</h2>${hint ? `<p class=hint>${hint}</p>` : ''}${body}</div>`);");
  File_write_line(p_file, "  if (rows.length) {");
  File_write_line(p_file, "    panel('Slowest on average', 'Mean time a call, every data set together. Click a bar for the function.',");
  File_write_line(p_file, "      barChart(topN(rows, (a) => a.mean).map((a) => ({label: a.fn.name, value: a.mean, id: a.f, tip: a.fn.part})), us));");
  File_write_line(p_file, "    panel('Slowest single call', 'The worst call each function made.',");
  File_write_line(p_file, "      barChart(topN(rows, (a) => a.max).map((a) => ({label: a.fn.name, value: a.max, id: a.f, colour: 'var(--bad)'})), us));");
  File_write_line(p_file, "    panel('Most time overall', 'Time spent in the function over all its calls.',");
  File_write_line(p_file, "      barChart(topN(rows, (a) => a.total).map((a) => ({label: a.fn.name, value: a.total * 1000, id: a.f, colour: 'var(--s2)'})), us));");
  File_write_line(p_file, "    panel('Least steady', 'Spread of call times divided by the mean, for functions taking a microsecond or more: high means some calls take much longer than others.',");
  File_write_line(p_file, "      barChart(topN(rows.filter((a) => a.calls > 2 && a.mean >= 1), (a) => a.jitter).map((a) => ({label: a.fn.name, value: a.jitter, id: a.f, colour: 'var(--warn)'})), (v) => v.toFixed(2) + ' \\u00d7'));");
  File_write_line(p_file, "    const byPart = parts.map((p) => ({label: p, value: rows.filter((a) => a.fn.part === p).reduce((s, a) => s + a.total * 1000, 0)}));");
  File_write_line(p_file, "    panel('Time by part of the game', 'Total time in the functions of each part.', barChart(byPart.sort((x, y) => y.value - x.value), us));");
  File_write_line(p_file, "    const multi = rows.filter((a) => Object.keys(a.sets).length > 1);");
  File_write_line(p_file, "    if (multi.length) {");
  File_write_line(p_file, "      panel('Most affected by the inputs', 'Slowest data set divided by the fastest: these functions cost very different amounts depending on what they are given.',");
  File_write_line(p_file, "        barChart(topN(multi, (a) => a.ratio).map((a) => {");
  File_write_line(p_file, "          const worst = Object.values(a.sets).sort((x, y) => y.mean - x.mean)[0];");
  File_write_line(p_file, "          return {label: a.fn.name, value: a.ratio, id: a.f, colour: SET_COLOUR[worst.s], tip: 'slowest with ' + SETS[worst.s] + ' inputs'};");
  File_write_line(p_file, "        }), (v) => v.toFixed(1) + ' \\u00d7'));");
  File_write_line(p_file, "      const sets = [1, 2, 3].filter((s) => R.runs.some((r) => r.s === s));");
  File_write_line(p_file, "      const series = sets.map((s) => ({name: SETS[s], colour: SET_COLOUR[s]}));");
  File_write_line(p_file, "      const groups = parts.map((p) => ({label: p, values: sets.map((s) => {");
  File_write_line(p_file, "        const rs = R.runs.filter((r) => r.s === s && r.fn.part === p);");
  File_write_line(p_file, "        return rs.length ? rs.reduce((t, r) => t + r.mean, 0) / rs.length : null;");
  File_write_line(p_file, "      })}));");
  File_write_line(p_file, "      panel('Data sets by part', 'Mean time a call of the functions in each part, for each data set.', legend(series) + groupedBars(groups, series, us));");
  File_write_line(p_file, "    }");
  File_write_line(p_file, "    const hist = new Array(8).fill(0);");
  File_write_line(p_file, "    for (const r of R.runs) r.b.forEach((c, i) => { hist[i] += c; });");
  File_write_line(p_file, "    panel('How long calls take', 'Every call made, by how long it took.',");
  File_write_line(p_file, "      barChart(BUCKETS.map((b, i) => ({label: b, value: hist[i]})), big));");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "  if (R.checks.length) {");
  File_write_line(p_file, "    const groups = [...new Set(R.checks.map((c) => c[0]))];");
  File_write_line(p_file, "    panel('Unit tests by group', failed.length ? `<span class=fail>${failed.length} failed</span>` : '<span class=pass>All passed</span>',");
  File_write_line(p_file, "      barChart(groups.map((g) => {");
  File_write_line(p_file, "        const all = R.checks.filter((c) => c[0] === g), bad = all.filter((c) => !c[4]).length;");
  File_write_line(p_file, "        return {label: g + (bad ? ' (' + bad + ' failed)' : ''), value: all.length, colour: bad ? 'var(--bad)' : 'var(--good)'};");
  File_write_line(p_file, "      }), big));");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "  $('tab-overview').innerHTML = `<div class=grid>${P.join('')}</div>`;");
  File_write_line(p_file, "})();");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- sortable tables");
  File_write_line(p_file, "function table(host, cols, data, opts) {");
  File_write_line(p_file, "  let key = opts.sort || 0, dir = opts.dir || -1;");
  File_write_line(p_file, "  function draw() {");
  File_write_line(p_file, "    const c = cols[key];");
  File_write_line(p_file, "    const list = data().slice().sort((x, y) => {");
  File_write_line(p_file, "      const a = c.v(x), b = c.v(y);");
  File_write_line(p_file, "      if (typeof a === 'string' || typeof b === 'string') return dir * String(a).localeCompare(String(b));");
  File_write_line(p_file, "      return dir * ((a === null ? -Infinity : a) - (b === null ? -Infinity : b));");
  File_write_line(p_file, "    });");
  File_write_line(p_file, "    const max = {};");
  File_write_line(p_file, "    cols.forEach((col, i) => { if (col.bar) max[i] = Math.max(1e-12, ...list.map((r) => col.v(r) || 0)); });");
  File_write_line(p_file, "    host.innerHTML = list.length ? `<table><thead><tr>${cols.map((col, i) => `<th class='sort ${col.n ? 'n' : ''} ${i === key ? (dir > 0 ? 'up' : 'down') : ''}' data-i='${i}' title='${esc(col.tip || '')}'>${col.t}</th>`).join('')}</tr></thead><tbody>` +");
  File_write_line(p_file, "      list.map((r) => '<tr>' + cols.map((col, i) => `<td class='${col.n ? 'n' : ''}'>${col.h ? col.h(r) : esc(col.v(r))}${col.bar && col.v(r) ? `<span class=mini style='width:${Math.round(60 * col.v(r) / max[i])}px'></span>` : ''}</td>`).join('') + '</tr>').join('') +");
  File_write_line(p_file, "      '</tbody></table>' : '<div class=empty>Nothing matches</div>';");
  File_write_line(p_file, "    if (opts.after) opts.after(list.length);");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "  host.addEventListener('click', (e) => {");
  File_write_line(p_file, "    const th = e.target.closest('th.sort');");
  File_write_line(p_file, "    if (!th) return;");
  File_write_line(p_file, "    const i = Number(th.dataset.i);");
  File_write_line(p_file, "    if (i === key) dir = -dir; else { key = i; dir = cols[i].n ? -1 : 1; }");
  File_write_line(p_file, "    draw();");
  File_write_line(p_file, "  });");
  File_write_line(p_file, "  draw();");
  File_write_line(p_file, "  return draw;");
  File_write_line(p_file, "}");
  File_write_line(p_file, "const fnLink = (a) => `<a class=fn data-fn='${a.f}'>${esc(a.fn.name)}</a>` +");
  File_write_line(p_file, "  (a.suspicious ? `<span class='tag bad' title='returned the largest or smallest number: maybe an overflow or a divide by zero'>suspicious</span>` : '') +");
  File_write_line(p_file, "  (a.fn.writes ? `<span class=tag>writes files</span>` : '');");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- functions tab");
  File_write_line(p_file, "(function functionsTab() {");
  File_write_line(p_file, "  const host = $('tab-functions');");
  File_write_line(p_file, "  host.innerHTML = `<div class=panel><div class=tools><input type=search id=fq placeholder='Find a function, file or part'>");
  File_write_line(p_file, "    <select id=fpart><option value=''>Every part</option>${parts.map((p) => `<option>${esc(p)}</option>`).join('')}</select>");
  File_write_line(p_file, "    <select id=fset><option value='0'>Every data set together</option>${[1, 2, 3].filter((s) => R.runs.some((r) => r.s === s)).map((s) => `<option value=${s}>${SETS[s]} inputs</option>`).join('')}</select>");
  File_write_line(p_file, "    <label class=chk><input type=checkbox id=fsus> only suspicious</label><span class=sub id=fcount></span></div><div id=ftable></div></div>`;");
  File_write_line(p_file, "  const pick = (a) => { const s = Number($('fset').value); return s ? a.sets[s] : null; };");
  File_write_line(p_file, "  const val = (a, k) => { const r = pick(a); if (Number($('fset').value) && !r) return null; return r ? r[k] : a[k]; };");
  File_write_line(p_file, "  const cols = [");
  File_write_line(p_file, "    {t: 'Function', v: (a) => a.fn.name, h: fnLink},");
  File_write_line(p_file, "    {t: 'Part', v: (a) => a.fn.part},");
  File_write_line(p_file, "    {t: 'Calls', n: 1, v: (a) => val(a, a === null ? 'n' : (pick(a) ? 'n' : 'calls')), h: (a) => big(val(a, pick(a) ? 'n' : 'calls') || 0)},");
  File_write_line(p_file, "    {t: 'Mean', n: 1, bar: 1, v: (a) => val(a, 'mean'), h: (a) => us(val(a, 'mean')), tip: 'mean time a call'},");
  File_write_line(p_file, "    {t: 'Fastest', n: 1, v: (a) => val(a, 'min'), h: (a) => us(val(a, 'min'))},");
  File_write_line(p_file, "    {t: 'Slowest', n: 1, v: (a) => val(a, 'max'), h: (a) => us(val(a, 'max'))},");
  File_write_line(p_file, "    {t: 'Spread', n: 1, v: (a) => val(a, 'sd'), h: (a) => us(val(a, 'sd')), tip: 'standard deviation of call times'},");
  File_write_line(p_file, "    {t: 'All calls', n: 1, bar: 1, v: (a) => pick(a) ? pick(a).fnms * 1000 : a.total * 1000, h: (a) => us(pick(a) ? pick(a).fnms * 1000 : a.total * 1000)},");
  File_write_line(p_file, "    {t: 'Calls / s', n: 1, v: (a) => { const m = val(a, 'mean'); return m > 0 ? 1e6 / m : null; }, h: (a) => { const m = val(a, 'mean'); return m > 0 ? big(Math.round(1e6 / m)) : '-'; }},");
  File_write_line(p_file, "    {t: 'Lines', n: 1, v: (a) => a.fn.last ? a.fn.last - a.fn.first + 1 : null, h: (a) => a.fn.last ? a.fn.last - a.fn.first + 1 : '-'}");
  File_write_line(p_file, "  ];");
  File_write_line(p_file, "  const data = () => {");
  File_write_line(p_file, "    const q = $('fq').value.toLowerCase(), p = $('fpart').value;");
  File_write_line(p_file, "    return rows.filter((a) => (!q || (a.fn.name + ' ' + a.fn.file + ' ' + a.fn.part + ' ' + a.fn.module).toLowerCase().includes(q)) &&");
  File_write_line(p_file, "      (!p || a.fn.part === p) && (!$('fsus').checked || a.suspicious));");
  File_write_line(p_file, "  };");
  File_write_line(p_file, "  const draw = table($('ftable'), cols, data, {sort: 3, after: (n) => { $('fcount').textContent = n + ' of ' + rows.length; }});");
  File_write_line(p_file, "  for (const id of ['fq', 'fpart', 'fset', 'fsus']) $(id).addEventListener('input', draw);");
  File_write_line(p_file, "})();");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- data sets tab");
  File_write_line(p_file, "(function setsTab() {");
  File_write_line(p_file, "  const host = $('tab-sets');");
  File_write_line(p_file, "  const sets = [1, 2, 3].filter((s) => R.runs.some((r) => r.s === s));");
  File_write_line(p_file, "  if (sets.length < 2) {");
  File_write_line(p_file, "    host.innerHTML = `<div class=panel><div class=empty>Only one data set was run (${sets.map((s) => SETS[s]).join('')}). Set Data sets to all in the panel to compare them.</div></div>`;");
  File_write_line(p_file, "    return;");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "  host.innerHTML = `<div class=panel><h2>The same functions with different inputs</h2>");
  File_write_line(p_file, "    <p class=hint>typical: every parameter at its usual value \\u00b7 random: random values from each range \\u00b7 edges: the ends of each range. Results differ shows functions whose returned numbers change with the inputs; suspicious ones returned the largest or smallest number.</p>");
  File_write_line(p_file, "    <div class=tools><input type=search id=sq placeholder='Find a function'><label class=chk><input type=checkbox id=sdiff> only where the results differ</label><span class=sub id=scount></span></div><div id=stable></div></div>`;");
  File_write_line(p_file, "  const cols = [{t: 'Function', v: (a) => a.fn.name, h: fnLink}];");
  File_write_line(p_file, "  for (const s of sets) cols.push({t: SETS[s], n: 1, bar: 1, v: (a) => a.sets[s] ? a.sets[s].mean : null, h: (a) => a.sets[s] ? us(a.sets[s].mean) : '-', tip: 'mean time a call with ' + SETS[s] + ' inputs'});");
  File_write_line(p_file, "  cols.push({t: 'Slowest \\u00f7 fastest', n: 1, v: (a) => a.ratio, h: (a) => a.ratio.toFixed(2) + ' \\u00d7'});");
  File_write_line(p_file, "  for (const s of sets) cols.push({t: SETS[s] + ' returned', v: (a) => a.sets[s] && a.sets[s].hasret ? a.sets[s].rmin : null,");
  File_write_line(p_file, "    h: (a) => { const r = a.sets[s]; return r && r.hasret ? `<span class=mono>${num(r.rmin)}${r.rmin !== r.rmax ? ' to ' + num(r.rmax) : ''}</span>` : '-'; }});");
  File_write_line(p_file, "  cols.push({t: 'Results', v: (a) => (a.suspicious ? 2 : 0) + (a.differs ? 1 : 0),");
  File_write_line(p_file, "    h: (a) => (a.suspicious ? `<span class='tag bad'>suspicious</span>` : '') + (a.differs ? `<span class='tag warn'>differ</span>` : '<span class=tag>same</span>')});");
  File_write_line(p_file, "  const data = () => {");
  File_write_line(p_file, "    const q = $('sq').value.toLowerCase();");
  File_write_line(p_file, "    return rows.filter((a) => (!q || a.fn.name.toLowerCase().includes(q)) && (!$('sdiff').checked || a.differs || a.suspicious));");
  File_write_line(p_file, "  };");
  File_write_line(p_file, "  const draw = table($('stable'), cols, data, {sort: sets.length + 1, after: (n) => { $('scount').textContent = n + ' of ' + rows.length; }});");
  File_write_line(p_file, "  for (const id of ['sq', 'sdiff']) $(id).addEventListener('input', draw);");
  File_write_line(p_file, "})();");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- unit tests tab");
  File_write_line(p_file, "(function testsTab() {");
  File_write_line(p_file, "  const host = $('tab-tests');");
  File_write_line(p_file, "  if (!R.checks.length) { host.innerHTML = '<div class=panel><div class=empty>No unit tests in this run. Press Unit tests or Everything.</div></div>'; return; }");
  File_write_line(p_file, "  const groups = [...new Set(R.checks.map((c) => c[0]))];");
  File_write_line(p_file, "  host.innerHTML = `<div class=panel><div class=tools><input type=search id=tq placeholder='Find a check'>");
  File_write_line(p_file, "    <select id=tg><option value=''>Every group</option>${groups.map((g) => `<option>${esc(g)}</option>`).join('')}</select>");
  File_write_line(p_file, "    <label class=chk><input type=checkbox id=tf ${failed.length ? 'checked' : ''}> only failed</label><span class=sub id=tcount></span></div><div id=ttable></div></div>`;");
  File_write_line(p_file, "  const cols = [");
  File_write_line(p_file, "    {t: '', v: (c) => c[4] ? 1 : 0, h: (c) => c[4] ? '<span class=pass>pass</span>' : '<span class=fail>fail</span>'},");
  File_write_line(p_file, "    {t: 'Group', v: (c) => c[0]}, {t: 'Check', v: (c) => c[1], h: (c) => `<span class=mono>${esc(c[1])}</span>`},");
  File_write_line(p_file, "    {t: 'Wanted', v: (c) => c[2], h: (c) => `<span class=mono>${esc(c[2])}</span>`},");
  File_write_line(p_file, "    {t: 'Got', v: (c) => c[3], h: (c) => `<span class='mono ${c[4] ? '' : 'fail'}'>${esc(c[3])}</span>`}");
  File_write_line(p_file, "  ];");
  File_write_line(p_file, "  const data = () => {");
  File_write_line(p_file, "    const q = $('tq').value.toLowerCase(), g = $('tg').value;");
  File_write_line(p_file, "    return R.checks.filter((c) => (!q || c[1].toLowerCase().includes(q)) && (!g || c[0] === g) && (!$('tf').checked || !c[4]));");
  File_write_line(p_file, "  };");
  File_write_line(p_file, "  const draw = table($('ttable'), cols, data, {sort: 0, dir: 1, after: (n) => { $('tcount').textContent = n + ' of ' + R.checks.length; }});");
  File_write_line(p_file, "  for (const id of ['tq', 'tg', 'tf']) $(id).addEventListener('input', draw);");
  File_write_line(p_file, "})();");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- left out tab");
  File_write_line(p_file, "(function leftTab() {");
  File_write_line(p_file, "  const host = $('tab-left');");
  File_write_line(p_file, "  if (!R.skipped.length) { host.innerHTML = '<div class=panel><div class=empty>Nothing was left out.</div></div>'; return; }");
  File_write_line(p_file, "  host.innerHTML = '<div class=panel><div id=ltable></div></div>';");
  File_write_line(p_file, "  const list = R.skipped.map((id) => fnById[id]);");
  File_write_line(p_file, "  table($('ltable'), [{t: 'Function', v: (f) => f.name}, {t: 'Part', v: (f) => f.part},");
  File_write_line(p_file, "    {t: 'Why', v: (f) => f.why || 'writes files (set the panel to include them)'}], () => list, {sort: 0, dir: 1});");
  File_write_line(p_file, "})();");
  File_write_line(p_file, "");
  File_write_line(p_file, "// ---------------------------------------------------------------- one function in detail");
  File_write_line(p_file, "function openFn(id) {");
  File_write_line(p_file, "  const a = byFn.get(Number(id));");
  File_write_line(p_file, "  const f = fnById[id];");
  File_write_line(p_file, "  if (!f) return;");
  File_write_line(p_file, "  const sets = a ? Object.values(a.sets).sort((x, y) => x.s - y.s) : [];");
  File_write_line(p_file, "  let h = `<button class=close onclick='closeFn()'>Close</button><h1>${esc(f.name)}</h1>`;");
  File_write_line(p_file, "  h += `<div class=sub>${esc(f.kind === 'library' ? '12d library call' : f.part + ' \\u00b7 ' + f.module)}</div>`;");
  File_write_line(p_file, "  h += `<h3>Signature</h3><div class=sig>${esc(f.sig)}</div><dl>`;");
  File_write_line(p_file, "  if (f.kind !== 'library') h += `<dt>Where</dt><dd>${esc(f.file)}, lines ${f.first} to ${f.last} (${f.last - f.first + 1} lines)</dd>`;");
  File_write_line(p_file, "  if (f.calls) h += `<dt>Calls</dt><dd>${f.calls.split(/[ ,]+/).filter(Boolean).map((c) => { const g = R.fns.find((x) => x.name === c); return g ? `<a class=fn data-fn='${g.id}'>${esc(c)}</a>` : esc(c); }).join(', ')}</dd>`;");
  File_write_line(p_file, "  const callers = R.fns.filter((g) => g.calls && g.calls.split(/[ ,]+/).includes(f.name));");
  File_write_line(p_file, "  if (callers.length) h += `<dt>Called by</dt><dd>${callers.slice(0, 40).map((g) => `<a class=fn data-fn='${g.id}'>${esc(g.name)}</a>`).join(', ')}${callers.length > 40 ? ' \\u2026' : ''}</dd>`;");
  File_write_line(p_file, "  if (f.writes) h += '<dt>Note</dt><dd>writes files (inside cubeland_worlds)</dd>';");
  File_write_line(p_file, "  if (f.why) h += `<dt>Not run</dt><dd>it ${esc(f.why)}</dd>`;");
  File_write_line(p_file, "  if (sets.length && sets[0].dom) h += `<dt>Inputs</dt><dd>${esc(sets[0].dom)}</dd>`;");
  File_write_line(p_file, "  h += '</dl>';");
  File_write_line(p_file, "  if (sets.length) {");
  File_write_line(p_file, "    const series = sets.map((r) => ({name: SETS[r.s], colour: SET_COLOUR[r.s]}));");
  File_write_line(p_file, "    h += '<h3>Each data set</h3><div class=panel><table><thead><tr><th>Data set</th><th class=n>Calls</th><th class=n>Mean</th><th class=n>First call</th><th class=n>Fastest</th><th class=n>Slowest</th><th class=n>Spread</th><th class=n>In the function</th><th class=n>With making inputs</th><th>Returned</th></tr></thead><tbody>';");
  File_write_line(p_file, "    for (const r of sets) {");
  File_write_line(p_file, "      h += `<tr><td><span class=sw style='background:${SET_COLOUR[r.s]}'></span>${SETS[r.s]}</td><td class=n>${big(r.n)}</td><td class=n>${us(r.mean)}</td><td class=n>${us(r.first)}</td><td class=n>${us(r.min)}</td><td class=n>${us(r.max)}</td><td class=n>${us(r.sd)}</td><td class=n>${us(r.fnms * 1000)}</td><td class=n>${us(r.ms * 1000)}</td>` +");
  File_write_line(p_file, "        `<td class=mono>${r.hasret ? num(r.rmin) + (r.rmin !== r.rmax ? ' to ' + num(r.rmax) + ', mean ' + num(r.rmean) : '') : '-'}</td></tr>`;");
  File_write_line(p_file, "    }");
  File_write_line(p_file, "    h += '</tbody></table></div><div class=grid style=margin-top:16px>';");
  File_write_line(p_file, "    h += `<div class=panel><h2>Time a call</h2>${legend(series)}${groupedBars([{label: 'fastest', values: sets.map((r) => r.min)}, {label: 'mean', values: sets.map((r) => r.mean)}, {label: 'first', values: sets.map((r) => r.first)}, {label: 'slowest', values: sets.map((r) => r.max)}], series, us)}</div>`;");
  File_write_line(p_file, "    h += `<div class=panel><h2>How long its calls took</h2>${legend(series)}${groupedBars(BUCKETS.map((b, i) => ({label: b.replace(' \\u00b5s', '').replace(' ms', 'ms'), values: sets.map((r) => r.n ? 100 * r.b[i] / r.n : 0)})), series, (v) => v.toFixed(0) + '%')}</div></div>`;");
  File_write_line(p_file, "    h += `<h3>Sample calls</h3><div class=tabs2>${sets.map((r, i) => `<button data-sample='${r.s}' class='${i ? '' : 'on'}'>${SETS[r.s]}</button>`).join('')}</div>`;");
  File_write_line(p_file, "    for (const r of sets) {");
  File_write_line(p_file, "      h += `<div class='panel sample ${r === sets[0] ? '' : 'hidden'}' data-set='${r.s}' style=margin-top:8px><table><thead><tr><th class=n>#</th><th>Inputs</th><th>Outputs</th><th class=n>Time</th></tr></thead><tbody>` +");
  File_write_line(p_file, "        r.smp.map((x, i) => `<tr><td class=n>${i + 1}</td><td class=mono>${esc(x[0])}</td><td class=mono>${esc(x[1])}</td><td class=n>${us(x[2])}</td></tr>`).join('') + '</tbody></table></div>';");
  File_write_line(p_file, "    }");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "  const code = document.getElementById('code' + id);");
  File_write_line(p_file, "  if (code) h += `<h3>Code</h3><pre class=code>${code.innerHTML}</pre>`;");
  File_write_line(p_file, "  else if (f.kind !== 'library') h += '<h3>Code</h3><div class=sub>Not in this report: set Source folder in the panel to the folder that holds src.</div>';");
  File_write_line(p_file, "  const d = $('drawer');");
  File_write_line(p_file, "  d.innerHTML = h;");
  File_write_line(p_file, "  d.classList.add('open');");
  File_write_line(p_file, "  d.scrollTop = 0;");
  File_write_line(p_file, "}");
  File_write_line(p_file, "function closeFn() { $('drawer').classList.remove('open'); }");
  File_write_line(p_file, "document.addEventListener('click', (e) => {");
  File_write_line(p_file, "  const t = e.target.closest('[data-fn]');");
  File_write_line(p_file, "  if (t && t.dataset.fn) { openFn(t.dataset.fn); return; }");
  File_write_line(p_file, "  const b = e.target.closest('[data-sample]');");
  File_write_line(p_file, "  if (b) {");
  File_write_line(p_file, "    for (const x of document.querySelectorAll('[data-sample]')) x.classList.toggle('on', x === b);");
  File_write_line(p_file, "    for (const p of document.querySelectorAll('.sample')) p.classList.toggle('hidden', p.dataset.set !== b.dataset.sample);");
  File_write_line(p_file, "  }");
  File_write_line(p_file, "});");
  File_write_line(p_file, "document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeFn(); });");
  File_write_line(p_file, "showTab(failed.length ? 'tests' : 'overview');");
  File_write_line(p_file, "</script>");
  File_write_line(p_file, "</body></html>");
}

#endif
